{
  "name": "@colight/format",
  "version": "0.0.0",
  "private": true,
  "description": "Dependency-free writer for the .colight binary container format (version 2).",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/colight-dev/colight.git"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./src/node.ts",
      "import": "./dist/node.js"
    },
    "./src/*": "./src/*"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
